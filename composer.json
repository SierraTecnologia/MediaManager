{
    "name": "sierratecnologia/media-manager",
    "description": "MediaManager de Arquivos",
    "type": "library",
    "keywords": [
        "sierratecnologia",
        "media-manager"
    ],
    "license": "MIT",
    "homepage": "https://sierratecnologia.com/packages/media-manager/",
    "support": {
        "email": "help@sierratecnologia.com.br",
        "issues": "https://github.com/sierratecnologia/media-manager/issues",
        "source": "https://github.com/sierratecnologia/media-manager",
        "docs": "https://github.com/sierratecnologia/media-manager/blob/master/README.md"
    },
    "authors": [
        {
            "name": "SierraTecnologia",
            "homepage": "https://sierratecnologia.com.br",
            "email": "help@sierratecnologia.com.br"
        },
        {
            "name": "Ricardo Rebello Sierra",
            "email": "contato@ricardosierra.com.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "sierratecnologia/muleta": "^2.0",
        "league/pipeline": "^1.1",
        "league/flysystem": "^3.36",
        "league/flysystem-ziparchive": "^3.31",
        "league/mime-type-detection": "^1.17",
        "intervention/image": "^2.7",
        "spatie/laravel-medialibrary": "^11.23",
        "doctrine/dbal": "^4.4"
    },
    "suggest": {
        "cipemotion/medialibrary": "*",
        "ctf0/media-manager": "Gerenciar Midias"
    },
    "autoload": {
        "psr-4": {
            "MediaManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MediaManager\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "bin": [
        "bin/media-manager"
    ],
    "scripts": {
        "post-install-cmd": [],
        "post-update-cmd": [],
        "post-create-project-cmd": [],
        "test": "vendor/bin/phpunit --no-coverage",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../**",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "MediaManager\\MediaManagerProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "orchestra/testbench": "^11.0"
    },
    "version": "2.3.0"
}
